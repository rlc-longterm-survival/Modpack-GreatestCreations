#!/bin/bash

set -eu -o pipefail

if (( $# < 1 )); then
    echo "Usage: rmmod <...packwiz_args>" >&2
    exit 1
fi

echo ======== Flatten ========
python build/toolkit.py flatten mods
echo ======== Remove ========
packwiz remove "$@" 
echo ======== Sort ========
python build/toolkit.py dangerously-prune -f mods
